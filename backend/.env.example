# Copiar para .env e preencher. Nunca fazer commit do .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lumara
# Obrigatório: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
CORS_ORIGENS=http://localhost:5173
AMBIENTE=desenvolvimento
SESSAO_INACTIVIDADE_HORAS=12
SESSAO_DURACAO_MAXIMA_DIAS=14
ANEXO_TAMANHO_MAXIMO_MB=8
FUSO_HORARIO=Africa/Luanda
# Só para testes (BD descartável, apagada a cada execução do pytest):
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lumara_test
# --- Inteligência artificial (Fase 3) — só no servidor, nunca no frontend ---
IA_FORNECEDOR=anthropic
# Chave da API da Anthropic (console.anthropic.com). Sem ela, o assistente diz "não configurado".
ANTHROPIC_API_KEY=
# Modelo: claude-opus-5-5 (recomendado) | claude-sonnet-5-5 | claude-haiku-5-5 (mais económicos)
IA_MODELO=claude-opus-5-5
IA_ESFORCO=medium
IA_LIMITE_PEDIDOS_HORA=30

# Avisos por email (melhoria nº 3) — sem chave, nada é enviado.
# Chave criada pela CEO na conta Resend (https://resend.com), com o domínio da Lumara verificado.
EMAIL_FORNECEDOR=resend
EMAIL_API_KEY=
EMAIL_REMETENTE=
# Endereço público da aplicação, para as ligações nos emails (ex.: https://lumara-business-os.onrender.com)
APP_URL=
